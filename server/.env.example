# Copy this file to .env and fill in real values. Never commit .env.

# --- Server (Phase 0) ---
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# --- Database (Phase 2) ---
DATABASE_URL="file:./dev.db"

# --- Auth (Phase 4) ---
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

