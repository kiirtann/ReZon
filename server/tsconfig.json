{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // NodeNext = real Node.js ES modules. Relative imports must end in ".js"
    // (even though the source file is .ts) because that is the file Node runs after compiling.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true
  },
  "include": ["src"]
}
